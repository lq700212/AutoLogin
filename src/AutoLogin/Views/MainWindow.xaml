<Window x:Class="AutoLogin.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:AutoLogin.Behaviors"
        Title="AutoLogin 自动登录配置"
        Width="1080" Height="700"
        MinWidth="1000" MinHeight="700"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Icon="pack://application:,,,/Assets/app.ico"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Closing="Window_Closing">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="62" />
                <RowDefinition Height="26" />
            </Grid.RowDefinitions>

            <!-- ===================== 标题栏 ===================== -->
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Source="pack://application:,,,/Assets/app.ico" Width="20" Height="20" />
                    <TextBlock Text="AutoLogin"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{StaticResource WhiteBrush}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                    <TextBlock Text="自动登录配置"
                               FontSize="12"
                               Foreground="{StaticResource SubTextBrush}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                    <Border Background="#202A4A" CornerRadius="8" Padding="7,1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding VersionText}" FontSize="10" Foreground="{StaticResource SubTextBrush}" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Style="{StaticResource WindowButton}" Click="Minimize_Click" ToolTip="最小化">
                        <TextBlock Text="—" FontSize="13" />
                    </Button>
                    <Button Style="{StaticResource WindowCloseButton}" Click="Close_Click" ToolTip="关闭">
                        <TextBlock Text="✕" FontSize="11" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===================== 内容区 ===================== -->
            <Grid Grid.Row="1" Margin="18,8,18,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="392" />
                </Grid.ColumnDefinitions>

                <!-- 左：配置卡片（整屏铺开，不使用滚动条） -->
                <StackPanel Grid.Column="0" VerticalAlignment="Top">

                    <!-- 卡片：目标软件 -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="目标软件" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="支持 .exe / .lnk / .ezd 等可打开文件"
                                           Style="{StaticResource HintText}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="86" />
                                </Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource DarkTextBox}"
                                         Text="{Binding ExePath, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="2"
                                        Content="浏览…"
                                        Style="{StaticResource SecondaryButton}"
                                        Height="34"
                                        Command="{Binding BrowseCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 卡片：登录账号 -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="登录账号" Style="{StaticResource CardTitle}" />
                                <CheckBox Content="显示密码"
                                          Style="{StaticResource PlainCheckBox}"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding ShowPassword}" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="用户名" Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource DarkTextBox}"
                                             Margin="0,5,0,0"
                                             Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="密码" Style="{StaticResource FieldLabel}" />
                                    <Grid Margin="0,5,0,0">
                                        <PasswordBox Style="{StaticResource DarkPasswordBox}"
                                                     behaviors:PasswordBoxBinding.BindPassword="True"
                                                     behaviors:PasswordBoxBinding.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Visibility="{Binding ShowPassword, Converter={StaticResource InverseBoolToVisibility}}" />
                                        <TextBox Style="{StaticResource DarkTextBox}"
                                                 Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 卡片：窗口识别与时序（一行五字段） -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="窗口识别与时序" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="留空 = 自动识别登录窗口"
                                           Style="{StaticResource HintText}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="0.85*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="0.95*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="0.95*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="标题关键词" Style="{StaticResource FieldLabel}" TextTrimming="CharacterEllipsis" />
                                    <TextBox Style="{StaticResource DarkTextBox}"
                                             Margin="0,5,0,0"
                                             Text="{Binding TitleKeyword, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="用户名框序号" Style="{StaticResource FieldLabel}" TextTrimming="CharacterEllipsis" />
                                    <TextBox Style="{StaticResource DarkTextBox}"
                                             Margin="0,5,0,0"
                                             Text="{Binding UserEditOrdText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="等待窗口（秒）" Style="{StaticResource FieldLabel}" TextTrimming="CharacterEllipsis" />
                                    <TextBox Style="{StaticResource DarkTextBox}"
                                             Margin="0,5,0,0"
                                             Text="{Binding WaitWindowSecText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="就绪延时（毫秒）" Style="{StaticResource FieldLabel}" TextTrimming="CharacterEllipsis" />
                                    <TextBox Style="{StaticResource DarkTextBox}"
                                             Margin="0,5,0,0"
                                             Text="{Binding ReadyDelayMsText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="8">
                                    <TextBlock Text="打字间隔（毫秒）" Style="{StaticResource FieldLabel}" TextTrimming="CharacterEllipsis" />
                                    <TextBox Style="{StaticResource DarkTextBox}"
                                             Margin="0,5,0,0"
                                             Text="{Binding TypeDelayMsText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="用户名 = 第 N 个非密码输入框；认错框时改 2，日志会列出各框当前内容。"
                                       Style="{StaticResource HintText}"
                                       Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 卡片：行为（三列横排） -->
                    <Border Style="{StaticResource CardBorder}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="行为" Style="{StaticResource CardTitle}" />

                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Style="{StaticResource ToggleSwitch}"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding MsgBoxOnFail}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock Text="失败时弹窗提示" FontSize="11.5" Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="不打断现场可关闭"
                                                   FontSize="10"
                                                   Foreground="{StaticResource SubTextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,1,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Column="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Style="{StaticResource ToggleSwitch}"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding RetryOnStillOpen}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock Text="未关闭时重试" FontSize="11.5" Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="默认关闭防误打"
                                                   FontSize="10"
                                                   Foreground="{StaticResource SubTextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,1,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Column="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Style="{StaticResource ToggleSwitch}"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding AutoStart}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock Text="开机自动运行" FontSize="11.5" Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="{Binding AutoStartHint}"
                                                   ToolTip="{Binding AutoStartHint}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource SubTextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,1,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- 右：运行日志 -->
                <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="46" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="30" />
                        </Grid.RowDefinitions>

                        <Grid Margin="14,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="运行日志"
                                           FontSize="12.5"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}" />
                            </StackPanel>
                            <Button Content="清空"
                                    Style="{StaticResource SmallButton}"
                                    Width="52"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Command="{Binding ClearLogCommand}" />
                        </Grid>

                        <Border Grid.Row="1"
                                Background="{StaticResource BoxBgBrush}"
                                BorderBrush="{StaticResource DividerBrush}"
                                BorderThickness="0,1,0,1">
                            <ListBox x:Name="LogList"
                                     Style="{StaticResource LogListBox}"
                                     Margin="12,10,6,8"
                                     ItemsSource="{Binding Logs}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TimeText}"
                                                       FontSize="10.5"
                                                       Foreground="{StaticResource SubTextBrush}"
                                                       VerticalAlignment="Top" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Message}"
                                                       FontSize="11.5"
                                                       Foreground="{Binding Level, Converter={StaticResource LogLevelToBrush}}"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <TextBlock Grid.Row="2"
                                   Margin="14,0,12,0"
                                   VerticalAlignment="Center"
                                   FontSize="10.5"
                                   Foreground="{StaticResource SubTextBrush}">
                            <Run Text="共 " /><Run Text="{Binding Logs.Count, Mode=OneWay}" /><Run Text=" 条 · 文件日志 AutoLogin.log" />
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===================== 动作栏 ===================== -->
            <Grid Grid.Row="2" Margin="18,0,18,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Button Content="{Binding RunButtonText}"
                            Style="{StaticResource PrimaryButton}"
                            Width="176"
                            Command="{Binding RunCommand}" />
                    <Button Content="仅保存"
                            Style="{StaticResource SecondaryButton}"
                            Width="96"
                            Margin="10,0,0,0"
                            Command="{Binding SaveCommand}" />
                    <Button Content="恢复默认"
                            Style="{StaticResource SecondaryButton}"
                            Width="96"
                            Margin="10,0,0,0"
                            Command="{Binding ResetDefaultsCommand}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="打开日志"
                            Style="{StaticResource SecondaryButton}"
                            Width="96"
                            Command="{Binding OpenLogCommand}" />
                    <Button Content="打开文件夹"
                            Style="{StaticResource SecondaryButton}"
                            Width="106"
                            Margin="10,0,0,0"
                            Command="{Binding OpenFolderCommand}" />
                </StackPanel>
            </Grid>

            <!-- ===================== 状态栏 ===================== -->
            <Grid Grid.Row="3" Margin="18,0,18,0">
                <TextBlock Text="{Binding StatusText}"
                           Foreground="{Binding StatusLevel, Converter={StaticResource StatusLevelToBrush}}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,220,0" />
                <TextBlock Text="{Binding ConfigPathText}"
                           ToolTip="{Binding ConfigFullPath}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="10.5"
                           Foreground="{StaticResource SubTextBrush}" />
            </Grid>
        </Grid>
    </Border>
</Window>
