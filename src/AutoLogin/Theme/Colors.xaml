<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== 主题色（沿用原深色配色） ===================== -->
    <Color x:Key="BgColor">#14162B</Color>
    <Color x:Key="Bg2Color">#1B1B33</Color>
    <Color x:Key="CardColor">#1C2038</Color>
    <Color x:Key="CardBorderColor">#2E3557</Color>
    <Color x:Key="TextColor">#E8ECF4</Color>
    <Color x:Key="SubTextColor">#8FA3C8</Color>
    <Color x:Key="BoxBgColor">#10131F</Color>
    <Color x:Key="BoxBorderColor">#394564</Color>
    <Color x:Key="AccentColor">#2196F3</Color>
    <Color x:Key="AccentDarkColor">#1A73E8</Color>
    <Color x:Key="AccentDeepColor">#0F4C81</Color>
    <Color x:Key="ToggleOffColor">#FF7A7A</Color>
    <Color x:Key="ToggleOnColor">#6EE07A</Color>
    <Color x:Key="WarnColor">#FFBF59</Color>
    <Color x:Key="ErrorColor">#FF7A7A</Color>
    <Color x:Key="SuccessColor">#6EE07A</Color>
    <Color x:Key="DividerColor">#262D49</Color>
    <Color x:Key="ScrollThumbColor">#47527A</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="Bg2Brush" Color="{StaticResource Bg2Color}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="SubTextBrush" Color="{StaticResource SubTextColor}" />
    <SolidColorBrush x:Key="BoxBgBrush" Color="{StaticResource BoxBgColor}" />
    <SolidColorBrush x:Key="BoxBorderBrush" Color="{StaticResource BoxBorderColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}" />
    <SolidColorBrush x:Key="AccentDeepBrush" Color="{StaticResource AccentDeepColor}" />
    <SolidColorBrush x:Key="ToggleOffBrush" Color="{StaticResource ToggleOffColor}" />
    <SolidColorBrush x:Key="ToggleOnBrush" Color="{StaticResource ToggleOnColor}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{StaticResource ScrollThumbColor}" />
    <SolidColorBrush x:Key="SecFillBrush" Color="#2A3255" />
    <SolidColorBrush x:Key="SecFill2Brush" Color="#232A48" />
    <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFF" />

    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource BgColor}" Offset="0" />
        <GradientStop Color="{StaticResource Bg2Color}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource AccentDarkColor}" Offset="0" />
        <GradientStop Color="{StaticResource AccentDeepColor}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SecGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2A3255" Offset="0" />
        <GradientStop Color="#232A48" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="FocusLineBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF6464" Offset="0" />
        <GradientStop Color="#FFBF59" Offset="0.5" />
        <GradientStop Color="#47C9FF" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="AppFont">Microsoft YaHei UI</FontFamily>

</ResourceDictionary>
